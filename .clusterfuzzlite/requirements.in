#
# Regenerate requirements.txt with the versions uv.lock already pins:
#   uv export --no-dev --no-emit-project --no-hashes -o /tmp/lock.txt
#   uv pip compile .clusterfuzzlite/requirements.in -c /tmp/lock.txt \
#     --python-version 3.11 --python-platform x86_64-unknown-linux-gnu \
#     --generate-hashes --no-header -o .clusterfuzzlite/requirements.txt
