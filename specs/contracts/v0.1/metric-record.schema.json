{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every percentage keeps its support; ``value`` is null iff the denominator is 0.",
  "properties": {
    "cohort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cohort"
    },
    "denominator": {
      "minimum": 0,
      "title": "Denominator",
      "type": "integer"
    },
    "kind": {
      "default": "proportion",
      "enum": [
        "proportion",
        "rate"
      ],
      "title": "Kind",
      "type": "string"
    },
    "metric": {
      "minLength": 1,
      "title": "Metric",
      "type": "string"
    },
    "metric_version": {
      "minLength": 1,
      "title": "Metric Version",
      "type": "string"
    },
    "numerator": {
      "minimum": 0,
      "title": "Numerator",
      "type": "integer"
    },
    "undefined_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Undefined Reason"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "metric",
    "numerator",
    "denominator",
    "value",
    "metric_version"
  ],
  "title": "MetricRecord",
  "type": "object"
}
